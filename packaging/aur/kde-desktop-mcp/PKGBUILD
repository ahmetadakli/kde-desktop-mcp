# Maintainer: Ahmet Adaklı <ahmetadakli280@gmail.com>
# Builds desktop-mcp from the release's source. kde-desktop-mcp-bin installs
# the prebuilt binary of the GitHub release instead.
pkgname=kde-desktop-mcp
pkgver=0.15.0
pkgrel=1
pkgdesc="MCP server that lets AI agents control desktop apps through the accessibility tree (KDE Plasma, Hyprland)"
arch=('x86_64')
url="https://github.com/ahmetadakli/kde-desktop-mcp"
license=('MIT')
depends=('gcc-libs' 'glibc' 'at-spi2-core')
makedepends=('cargo')
optdepends=('spectacle: screenshots when KWin ScreenShot2 is unavailable'
            'grim: screenshots on Hyprland')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('79495d0924a6c91d7d6402fa314745fa80891d3811d78cf44bcea38cef6cc8ec')

prepare() {
  cd "$pkgname-$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver/rust"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 rust/target/release/desktop-mcp "$pkgdir/usr/bin/desktop-mcp"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
